program AlgoritmaBuatKopi;
uses crt;

begin
  clrscr;
  
  writeln('=== ALGORITMA MEMBUAT KOPI DI PAGI HARI ===');
  writeln('1. Mulai');
  writeln('2. Bangun dari tempat tidur dan cuci muka');
  writeln('3. Menuju ke dapur');
  writeln('4. Menyiapkan cangkir, sendok, kopi, gula, dan air panas');
  writeln('5. Memasukkan bubuk kopi secukupnya ke dalam cangkir');
  writeln('6. Menambahkan gula sesuai selera');
  writeln('7. Menuangkan air panas ke dalam cangkir');
  writeln('8. Mengaduk kopi hingga gula dan kopi larut');
  writeln('9. Menunggu kopi sedikit hangat agar tidak terlalu panas');
  writeln('10. Menikmati kopi sambil bersantai');
  writeln('11. Mencuci cangkir dan alat yang sudah dipakai');
  writeln('12. Selesai');
end.