program AlgoritmaBeliBakso;

uses crt;

begin
  clrscr;
  writeln('=== ALGORITMA MEMBELI BAKSO ===');
  writeln('1. Mulai');
  writeln('2. Menyiapkan uang untuk membeli bakso');
  writeln('3. Mengambil dompet dan memastikan uang cukup');
  writeln('4. Pergi menuju warung bakso langganan');
  writeln('5. Tiba di warung, memilih tempat duduk yang kosong');
  writeln('6. Memanggil penjual dan memesan bakso (misal: bakso campur)');
  writeln('7. Menunggu pesanan bakso disiapkan');
  writeln('8. Bakso diantar ke meja, memeriksa pesanan sesuai');
  writeln('9. Menikmati bakso (boleh ditambah sambal/kecap)');
  writeln('10. Selesai makan, memanggil penjual untuk membayar');
  writeln('11. Membayar sesuai harga dan menerima kembalian');
  writeln('12. Mengucapkan terima kasih dan berpamitan');
  writeln('13. Pulang / lanjut aktivitas');
  writeln('14. Selesai');
end.